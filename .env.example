# Discord webhook URL for the #management channel (mods only)
# Create one: Discord channel settings → Integrations → Webhooks → New Webhook
VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# GitHub fine-grained PAT — scoped to THIS repo only
# Required permissions: Contents (read/write), Pull requests (write)
# Create one: GitHub → Settings → Developer settings → Fine-grained tokens
VITE_GITHUB_TOKEN=github_pat_XXXXXX

# GitHub repo in "owner/repo" format
VITE_GITHUB_REPO=UnuSec/petmasters
